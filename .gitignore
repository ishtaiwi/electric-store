# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Database files - NEVER push to GitHub
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.safety_backup

# Supabase / secrets — NEVER commit real keys
.env
.env.*
!.env.example
**/.env
supabase/.env
supabase/data_export.sql
lib/core/config/supabase_secrets.dart
mobile/lib/core/config/supabase_secrets.dart
**/supabase_secrets.dart
!**/supabase_secrets.example.dart

# Generated/test data
generate_test_data.sql
test_data.db

# Windows build artifacts
/windows/flutter/ephemeral/

# Mobile / Android build artifacts — never commit
mobile/build/
mobile/**/build/
mobile/.dart_tool/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/.kotlin/
mobile/**/*.apk
mobile/**/*.aab
mobile/**/*.ap_
**/*.apk
**/*.aab

# Large installer binaries (optional local builds)
installer_output/*.exe

# Scratch / local notes
supabase/Untitled

# Metadata
.metadata
